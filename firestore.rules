rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Chat messages
    match /channels/{channel}/messages/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.by == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.nick is string
        && request.resource.data.nick.size() <= 24
        && request.resource.data.ts is number;
      // anyone can react, nobody can edit someone else's text
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
      // only delete your own messages
      allow delete: if request.auth != null && resource.data.by == request.auth.uid;
    }

    // Who's online / typing — you can only write your own
    match /presence/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Chat name — first person to rename becomes the owner
    match /meta/settings {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == resource.data.owner;
    }
  }
}
